# Copie para container/.env (esse arquivo fica fora do git) e preencha.

# Senha da API da bridge. Gere uma com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_BRIDGE_TOKEN=

# Modo de envio do servidor MCP: read-only (padrao), two-step ou hook.
# Em containers use read-only ou two-step; o modo hook so existe para o Claude Code.
WHATSAPP_SEND_MODE=read-only
